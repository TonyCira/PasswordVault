@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase

<div class="app-shell">
    <nav class="sidebar">
        <div class="sidebar-logo">
            <span class="logo-icon">🔐</span>
            <span class="logo-text">PasswordVault</span>
        </div>

        <div class="sidebar-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                <span class="nav-icon">✏️</span>
                <span class="nav-label">Ingave</span>
            </NavLink>
            <NavLink href="/overzicht" class="nav-item">
                <span class="nav-icon">🔍</span>
                <span class="nav-label">Overzicht</span>
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <span class="version-text">v1.0 · Lokaal & Privé</span>
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>
